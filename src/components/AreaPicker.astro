---
import mapImage from "../assets/area-map.png";
import { regions } from "../data/climbing-areas";
---

<section class="area-picker" aria-labelledby="area-picker-heading">
  <h3 id="area-picker-heading">Area</h3>
  <p class="area-picker-hint">Click a region on the map to filter by area.</p>

  <svg
    class="area-map"
    viewBox="0 0 400 460"
    role="group"
    aria-label="Map of NSW and ACT climbing regions"
  >
    <defs>
      <clipPath id="area-map-clip">
        <rect x="20" y="10" width="360" height="440" rx="16"></rect>
      </clipPath>
    </defs>
    <image
      href={mapImage.src}
      x="-164.1"
      y="-7.2"
      width="660.9"
      height="469.5"
      clip-path="url(#area-map-clip)"
      aria-hidden="true"
    ></image>
    <rect
      class="area-map-frame"
      x="20"
      y="10"
      width="360"
      height="440"
      rx="16"
      aria-hidden="true"
    ></rect>
    <text x="60" y="430" class="area-map-compass" aria-hidden="true">N ↑</text>
    {
      regions.map((region) => (
        <g class="area-map-region" data-region-id={region.id}>
          <ellipse
            role="button"
            tabindex="0"
            aria-pressed="false"
            aria-label={region.name}
            cx={region.cx}
            cy={region.cy}
            rx={region.rx}
            ry={region.ry}
          ></ellipse>
          <text
            class="area-map-label"
            x={region.cx}
            y={region.cy}
            aria-hidden="true"
          >
            {region.name}
          </text>
        </g>
      ))
    }
  </svg>

  <p class="area-picker-selected" aria-live="polite">
    <span id="selected-area-label">No area selected</span>
    <button type="button" class="area-picker-clear" data-area-clear hidden>
      Clear
    </button>
  </p>
</section>

<style>
  .area-picker {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .area-picker-hint {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .area-map {
    width: 100%;
    height: auto;
    max-height: 20rem;
  }

  .area-map-frame {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 2;
  }

  .area-map-compass {
    font-size: 0.75rem;
    font-weight: 600;
    fill: var(--color-text-muted);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 4px;
    user-select: none;
  }

  .area-map-region ellipse {
    fill: var(--color-accent-soft);
    fill-opacity: 0.85;
    stroke: var(--color-accent);
    stroke-width: 2;
    cursor: pointer;
    transition: fill 0.15s ease;
  }

  .area-map-region:hover ellipse,
  .area-map-region ellipse:focus-visible {
    fill: var(--color-accent);
    fill-opacity: 0.95;
  }

  .area-map-region.is-selected ellipse {
    fill: var(--color-accent);
    fill-opacity: 0.95;
    stroke: var(--color-accent-dark);
  }

  .area-map-region ellipse:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .area-map-label {
    font-size: 0.8rem;
    text-anchor: middle;
    fill: var(--color-text);
    paint-order: stroke;
    stroke: var(--color-surface);
    stroke-width: 3px;
    pointer-events: none;
    user-select: none;
  }

  .area-picker-selected {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .area-picker-clear {
    border: none;
    background: none;
    padding: 0;
    color: var(--color-link);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: underline;
  }
</style>
